{
	"files.autoSave": "off",
	"workbench.sash.size": 8,

	"editor.tabSize": 4,
	"editor.insertSpaces": false,
	"editor.detectIndentation": false,
	"editor.formatOnSave": false, 
	"editor.defaultFormatter": "oxc.oxc-vscode",
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit",
		"source.format.oxc": "always",
		"source.fixAll.oxc": "always",
	},
	"oxc.path.oxlint": "./node_modules/.bin/duplojs-oxlint",

	"[yaml]": {
		"editor.tabSize": 2,
		"editor.insertSpaces": true,
	},

	"[json]": {
		"editor.tabSize": 2,
		"editor.insertSpaces": true,
	},

	"js/ts.tsdk.path": "node_modules/typescript/lib",
	"js/ts.format.enabled": false,
	"js/ts.experimental.useTsgo": false,
	"js/ts.tsdk.promptToUseWorkspaceVersion": true,
	"js/ts.updateImportsOnFileMove.enabled": "prompt",

	"cSpell.words": [
		"chrono",
		"oxlint"
	],
	
	"prettier.enable": false,
	"json.format.enable": false,
	"html.format.enable": false,
	
	"vue.codeActions.askNewComponentName": false,

	"terminal.integrated.cwd": "${workspaceFolder:ecosystem}"
}